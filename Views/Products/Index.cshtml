@model IEnumerable<ECommerceApp.Models.Product>

@{
    ViewData["Title"] = "Sortiment";
}

<h1>Sortiment</h1>

<p>
    <a asp-action="Create" class="btn btn-primary" title="Login erforderlich" id="btnAlignment">Neuer Eintrag </a>
</p>
<div id="tableDesign">


    @foreach (var item in Model)
    {
        <a asp-action="Details" asp-route-id="@item.Id" class="row-link">
            <div class="row">



                <div class="cell">

                    @Html.DisplayFor(modelItem => item.Name)

                </div>
                <div class="cell">

                    @($"{item.Price:C}")

                </div>

                <div class="cell">


                    <div>

                        <img src="/assets/images/placeholder01.JPEG" alt="product-image" class="product-image"
                            title="Klicken für Details" />

                    </div>

                </div>

            </div>
        </a>
    }

</div>
